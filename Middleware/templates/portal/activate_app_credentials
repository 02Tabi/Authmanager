{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Activate App Credentials — Auth Manager</title>
</head>
<body>
  {% if invalid_link %}
    <h2>Invalid or Expired Link</h2>
    <p>This activation link is invalid or has expired. Please contact your administrator for a new one.</p>
  {% elif success %}
    <h2>Password Set Successfully</h2>
    <p>Your password for {{ app_name }} has been set. You may now log in to that application.</p>
  {% else %}
    <h2>Set Your Password for {{ app_name }}</h2>

    {% if messages %}
      <ul>
        {% for message in messages %}<li>{{ message }}</li>{% endfor %}
      </ul>
    {% endif %}

    <form method="POST">
      {% csrf_token %}
      <label>New Password</label><br>
      <input type="password" name="new_password" required><br><br>
      <label>Confirm Password</label><br>
      <input type="password" name="confirm_password" required><br><br>
      <button type="submit">Set Password</button>
    </form>
  {% endif %}
</body>
</html>